---
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  tags?: string[];
  canonicalPath?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'TinkSoft — notes on software, security, games, and whatever else interests me.',
  type = 'website',
  publishedAt,
  tags = [],
  canonicalPath,
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'posts', section: ['/', '/log'] },
  { href: '/projects/', label: 'projects', section: ['/projects'] },
  { href: '/archive/', label: 'archive', section: ['/archive'] },
  { href: '/tags/', label: 'tags', section: ['/tags'] },
  { href: '/now/', label: 'now', section: ['/now'] },
  { href: '/about/', label: 'about', section: ['/about'] },
];
const isHere = (section: string[]) =>
  section.some((s) =>
    s === '/' ? path === '/' : path === s || path.startsWith(`${s}/`)
  );

const pageLabel = title
  .replace(/ — TinkSoft$/, '')
  .replace(/^TinkSoft — /, '');
const thread = [{ href: '/', label: 'posts' }];

if (path.startsWith('/projects/') && path !== '/projects/') {
  thread.push({ href: '/projects/', label: 'projects' });
}

if (path.startsWith('/tags/') && path !== '/tags/') {
  thread.push({ href: '/tags/', label: 'tags' });
}

if (path !== '/') {
  thread.push({ href: path, label: pageLabel });
}

const footerLinks = [
  { href: '/archive/', label: 'archive' },
  { href: '/tags/', label: 'tags' },
  { href: '/rss.xml', label: 'rss' },
  { href: '/links/', label: 'links' },
  { href: '/colophon/', label: 'colophon' },
  { href: '/releases/', label: 'releases' },
  { href: '/demo/', label: 'demo' },
  { href: '/tinksoft.nfo', label: '.nfo' },
  { href: '/humans.txt', label: 'humans.txt' },
  { href: 'https://github.com/tinkthemaker/', label: 'github', me: true },
];
const canonical = new URL(canonicalPath ?? path, Astro.site);
const siteRoot = new URL('/', Astro.site);
const feed = new URL('/rss.xml', Astro.site);
const sitemap = new URL('/sitemap-index.xml', Astro.site);
const schemaType = type === 'article' ? 'BlogPosting' : path === '/' ? 'WebSite' : 'WebPage';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: schemaType === 'WebSite' ? 'TinkSoft' : pageLabel,
  ...(type === 'article' ? { headline: pageLabel } : {}),
  description,
  url: canonical.href,
  ...(schemaType !== 'WebSite' ? {
    isPartOf: { '@type': 'WebSite', name: 'TinkSoft', url: siteRoot.href },
  } : {}),
  ...(type === 'article' ? {
    datePublished: publishedAt?.toISOString(),
    keywords: tags,
    author: { '@type': 'Person', name: 'Tink', url: new URL('/about/', Astro.site).href },
  } : {}),
}).replace(/</g, '\\u003c');
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cstyle%3Erect%7Bfill:%23f4f0e4%7Dtext%7Bfill:%23008080%7D@media(prefers-color-scheme:dark)%7Brect%7Bfill:%23161613%7Dtext%7Bfill:%233fbdb0%7D%7D%3C/style%3E%3Crect width='32' height='32'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='bold' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Tink" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="TinkSoft posts" href={feed} />
  <link rel="sitemap" type="application/xml" title="TinkSoft sitemap" href={sitemap} />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:" />
  <meta name="theme-color" content="#f4f0e4" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161613" media="(prefers-color-scheme: dark)" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="TinkSoft" />
  <meta property="og:locale" content="en_US" />
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
  {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={structuredData}></script>
  <style is:global>
    :root {
      --bg: #f1eddf;
      --panel: #e8e1cf;
      --panel-2: #ddd4bd;
      --ink: #171713;
      --link: #0039a6;
      --visited: #6b2d83;
      --rule: #777264;
      --frame: #4f4c42;
      --accent: #00736f;
      --accent-2: #9c2dad;
      --hot: #985900;
      --muted: #575449;
      --badge-bg: #ded5bd;
      --code-bg: #171713;
      --code-ink: #5dff7d;
      --quote-ink: #3e3d36;
      --ship: #006b35;
      --wip: #9a4e00;
      --shadow: #afa58c;
      color-scheme: light dark;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #121310;
        --panel: #1b1d18;
        --panel-2: #25271f;
        --ink: #e1ddcf;
        --link: #82adff;
        --visited: #d59bf0;
        --rule: #505348;
        --frame: #66695b;
        --accent: #49d6c9;
        --accent-2: #d66cff;
        --hot: #ffca5c;
        --muted: #a19d90;
        --badge-bg: #282a22;
        --code-bg: #090a08;
        --code-ink: #52ff78;
        --quote-ink: #c0bcaf;
        --ship: #65d47c;
        --wip: #ffb75c;
        --shadow: #080906;
      }
    }
    * { box-sizing: border-box; }
    html {
      background: var(--bg);
      scroll-behavior: smooth;
    }
    body {
      margin: 0 auto;
      max-width: 68rem;
      padding: 0 1.25rem 3rem;
      font-family: ui-monospace, "Cascadia Mono", "SFMono-Regular", Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 16px;
      line-height: 1.6;
      color: var(--ink);
      overflow-wrap: break-word;
    }
    body::before {
      content: '';
      display: block;
      height: 4px;
      margin: 0 -1.25rem;
      background: linear-gradient(90deg, var(--accent) 0 36%, var(--accent-2) 36% 60%, var(--hot) 60% 78%, var(--ink) 78%);
    }
    ::selection { background: var(--accent); color: var(--bg); }
    a {
      color: var(--link);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
    a:visited { color: var(--visited); }
    a:hover { background: var(--ink); color: var(--bg); text-decoration: none; }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .skip {
      position: fixed;
      z-index: 20;
      left: -9999px;
    }
    .skip:focus {
      left: 0.75rem;
      top: 0.75rem;
      padding: 0.4rem 0.65rem;
      color: var(--ink);
      background: var(--bg);
      border: 2px solid var(--accent);
    }
    h1, h2, h3 { font-family: inherit; line-height: 1.18; text-wrap: balance; }
    h1 {
      margin: 0 0 0.8rem;
      font-size: clamp(1.65rem, 4vw, 2.25rem);
      letter-spacing: -0.035em;
    }
    h2 {
      margin-top: 2.4rem;
      font-size: 1.25rem;
    }
    main > h2::before, .content > h2::before { content: '// '; color: var(--accent); }
    h3 { margin-top: 1.75rem; font-size: 1.05rem; color: var(--hot); }
    p { max-width: 76ch; }
    hr {
      border: none;
      border-top: 1px solid var(--rule);
      margin: 1.75rem 0;
    }
    main { min-width: 0; }
    .system-bar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.45rem 0;
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .system-state { white-space: nowrap; }
    .system-bar > span { white-space: nowrap; }
    .led {
      display: inline-block;
      width: 0.55rem;
      height: 0.55rem;
      margin-right: 0.35rem;
      border-radius: 50%;
      background: var(--ship);
      box-shadow: 0 0 0 2px var(--panel-2);
    }
    .masthead {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.5rem;
      align-items: end;
      padding: 1.25rem;
      border: 1px solid var(--frame);
      background: var(--panel);
      box-shadow: 4px 4px 0 var(--shadow);
    }
    pre.ascii {
      max-width: 100%;
      margin: 0;
      overflow: hidden;
      color: var(--accent);
      font-size: clamp(7px, 1.5vw, 13px);
      line-height: 1.1;
      user-select: none;
      text-shadow: 1px 0 var(--accent-2);
    }
    a.logo { display: inline-block; max-width: 100%; }
    a.logo:hover { background: none; color: inherit; }
    .tagline { margin: 0.7rem 0 0; color: var(--muted); font-size: 0.82rem; }
    .telemetry {
      margin: 0;
      padding-left: 1rem;
      border-left: 1px solid var(--rule);
      font-size: 0.68rem;
      line-height: 1.55;
      text-transform: uppercase;
    }
    .telemetry div { display: grid; grid-template-columns: auto auto; gap: 1rem; }
    .telemetry dt { color: var(--muted); }
    .telemetry dd { margin: 0; color: var(--accent); text-align: right; }
    nav.site {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 0.5rem;
      margin-top: 0.9rem;
      padding: 0.55rem 0.75rem;
      border-block: 1px solid var(--rule);
      background: var(--panel);
      letter-spacing: 0.02em;
      font-size: 0.86rem;
    }
    .navitem { display: inline-block; white-space: nowrap; }
    nav.site a[aria-current='page'] {
      color: var(--bg);
      background: var(--accent);
      text-decoration: none;
      font-weight: bold;
    }
    nav.thread {
      margin: 0.85rem 0 2rem;
      color: var(--muted);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.045em;
    }
    nav.thread::before { content: 'PATH :: '; color: var(--accent); font-weight: bold; }
    nav.thread ol { display: inline-flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
    nav.thread li:not(:last-child)::after { content: ' /'; color: var(--rule); }
    nav.thread [aria-current='page'] { color: var(--ink); font-weight: bold; }
    .scene-panel {
      position: relative;
      padding: 1.25rem;
      border: 1px solid var(--frame);
      background: var(--panel);
      box-shadow: 4px 4px 0 var(--shadow);
    }
    .scene-label {
      display: inline-block;
      margin: -2rem 0 0.85rem -0.5rem;
      padding: 0 0.45rem;
      color: var(--accent);
      background: var(--bg);
      font-size: 0.75rem;
      font-weight: bold;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .eyebrow { color: var(--accent); font-size: 0.75rem; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; }
    .action {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--rule);
      background: var(--panel-2);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: bold;
    }
    table.log { width: 100%; border-collapse: collapse; }
    table.log tr { border-bottom: 1px dotted var(--rule); }
    table.log td { padding: 0.65rem 0.75rem 0.65rem 0; vertical-align: top; }
    td.date { white-space: nowrap; color: var(--muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
    .post-meta { color: var(--muted); font-size: 0.82rem; }
    nav.post-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    nav.post-nav p { margin: 0; padding: 0.75rem; border: 1px solid var(--rule); background: var(--panel); }
    .content { max-width: 50rem; }
    .content :is(pre) {
      padding: 1rem;
      overflow-x: auto;
      color: var(--code-ink);
      background: var(--code-bg);
      border: 1px solid var(--frame);
      box-shadow: 3px 3px 0 var(--shadow);
      font-size: 0.84rem;
      line-height: 1.5;
    }
    .content :is(code):not(pre code) { padding: 0.08rem 0.3rem; background: var(--badge-bg); color: var(--ink); }
    .content blockquote { margin-left: 0; padding: 0.3rem 0 0.3rem 1rem; border-left: 3px solid var(--accent-2); color: var(--quote-ink); }
    .content img { max-width: 100%; height: auto; border: 1px solid var(--rule); }
    footer { margin-top: 4rem; color: var(--muted); font-size: 0.76rem; }
    .footer-rule { height: 3px; margin-bottom: 1rem; background: linear-gradient(90deg, var(--accent), var(--accent-2) 55%, transparent 55%); }
    .footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; padding: 1rem; border: 1px solid var(--rule); background: var(--panel); }
    .footer-heading { margin: 0 0 0.55rem; color: var(--accent); font-weight: bold; letter-spacing: 0.06em; }
    .footer-grid p { margin: 0.35rem 0; }
    .badge { display: inline-block; margin: 0 0.35rem 0.35rem 0; padding: 0.08rem 0.4rem; border: 1px solid var(--rule); background: var(--badge-bg); color: var(--ink); font-size: 0.67rem; }
    .footer-end { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.8rem; }
    img.counter { vertical-align: middle; border: 1px solid var(--rule); image-rendering: pixelated; }
    .return { margin-bottom: 1rem; }
    .status-ship { color: var(--ship); font-weight: bold; }
    .status-wip { color: var(--wip); font-weight: bold; }
    .status-idea { color: var(--muted); font-weight: bold; }
    @media (max-width: 48rem) {
      body { padding-inline: 0.8rem; }
      body::before { margin-inline: -0.8rem; }
      .system-bar { font-size: 0.62rem; }
      .masthead { grid-template-columns: 1fr; padding: 0.85rem; box-shadow: 3px 3px 0 var(--shadow); }
      .telemetry { display: none; }
      pre.ascii { font-size: clamp(6px, 2.35vw, 11px); }
      .tagline { font-size: 0.76rem; }
      nav.site { margin-top: 0.65rem; padding: 0.45rem 0.55rem; gap: 0.2rem 0.42rem; font-size: 0.78rem; }
      nav.thread { margin-bottom: 1.5rem; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-end { display: block; }
    }
    @media (max-width: 30rem) {
      .system-bar { gap: 0.5rem; font-size: 0.58rem; }
      table.log, table.log tbody, table.log tr, table.log td { display: block; }
      table.log td { padding: 0; }
      table.log tr { padding: 0.75rem 0; }
      table.log tr + tr { margin-top: 0.35rem; }
      nav.post-nav { grid-template-columns: 1fr; }
      .scene-panel { padding: 1rem; }
      h1 { font-size: 1.6rem; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">skip to content</a>
  <div class="system-bar" aria-label="site status">
    <span>TINKSOFT // PUBLIC NODE 01</span>
    <span class="system-state"><span class="led" aria-hidden="true"></span>ONLINE &middot; STATIC</span>
  </div>
  <header>
    <div class="masthead">
      <div>
        <a class="logo" href="/" aria-label="TinkSoft home" style="text-decoration:none"><pre class="ascii" aria-hidden="true">
 _____ ___ _   _ _  ______   ___  _____ _____
|_   _|_ _| \ | | |/ / ___| / _ \|  ___|_   _|
  | |  | ||  \| | ' /\___ \| | | | |_    | |
  | |  | || |\  | . \ ___) | |_| |  _|   | |
  |_| |___|_| \_|_|\_\____/ \___/|_|     |_|</pre></a>
        <p class="tagline">// software, security, games, and whatever else interests me.</p>
      </div>
      <dl class="telemetry" aria-label="site telemetry">
        <div><dt>mode</dt><dd>personal</dd></div>
        <div><dt>output</dt><dd>static html</dd></div>
        <div><dt>client</dt><dd>0 kb js</dd></div>
        <div><dt>tracking</dt><dd>none</dd></div>
      </dl>
    </div>
    <nav class="site" aria-label="site">
      {nav.map((item) => (
        <span class="navitem">[<a
          href={item.href}
          aria-current={isHere(item.section) ? 'page' : undefined}
        >{item.label}</a>]</span>
      ))}
      <span class="navitem">[<a href="https://github.com/tinkthemaker/" rel="me">github</a>]</span>
    </nav>
  </header>

  <nav class="thread" aria-label="page trail">
    <ol>
      {thread.map((item, index) => (
        <li>
          {index === thread.length - 1
            ? <span aria-current="page">{item.label}</span>
            : <a href={item.href}>{item.label}</a>}
        </li>
      ))}
    </ol>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    {path !== '/' && <p class="return"><a href="/">&laquo; return to posts</a></p>}
    <div class="footer-rule" aria-hidden="true"></div>
    <div class="footer-grid">
      <section aria-labelledby="footer-system">
        <p class="footer-heading" id="footer-system">[SYSTEM]</p>
        <p>
          <span class="badge">PERSONAL SITE</span><span class="badge">PLAIN HTML</span><span class="badge">0 KB JS</span><span class="badge">NO TRACKING</span><span class="badge">EST. 2026</span>
        </p>
        <p>One operator. No platform. Files stay readable.</p>
      </section>
      <section aria-labelledby="footer-links">
        <p class="footer-heading" id="footer-links">[MORE FILES]</p>
        <nav aria-label="more">
          {footerLinks.map((item) => (
            <span class="navitem">[<a href={item.href} rel={item.me ? 'me' : undefined}>{item.label}</a>]</span>
          ))}
        </nav>
      </section>
    </div>
    <p class="footer-end">
      <span>counter: <img class="counter" src="/counter.svg" alt="static counter: 0001337" width="66" height="20" /></span>
      <span>&copy; {new Date().getFullYear()} tinksoft.com &middot; tink &middot; EOF</span>
    </p>
  </footer>
</body>
</html>
