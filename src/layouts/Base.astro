---
import { themeCss } from '../lib/theme.mjs';
import { ART, TORCHES } from '../generated/dither-art.mjs';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  tags?: string[];
  canonicalPath?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'TinkSoft — notes on software, security, games, and whatever else interests me.',
  type = 'website',
  publishedAt,
  tags = [],
  canonicalPath,
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'posts', section: ['/', '/log'] },
  { href: '/projects/', label: 'projects', section: ['/projects'] },
  { href: '/archive/', label: 'archive', section: ['/archive'] },
  { href: '/tags/', label: 'tags', section: ['/tags'] },
  { href: '/now/', label: 'now', section: ['/now'] },
  { href: '/about/', label: 'about', section: ['/about'] },
];
const isHere = (section: string[]) =>
  section.some((s) =>
    s === '/' ? path === '/' : path === s || path.startsWith(`${s}/`)
  );

const pageLabel = title
  .replace(/ — TinkSoft$/, '')
  .replace(/^TinkSoft — /, '');
const thread = [{ href: '/', label: 'posts' }];

if (path.startsWith('/projects/') && path !== '/projects/') {
  thread.push({ href: '/projects/', label: 'projects' });
}

if (path.startsWith('/tags/') && path !== '/tags/') {
  thread.push({ href: '/tags/', label: 'tags' });
}

if (path !== '/') {
  thread.push({ href: path, label: pageLabel });
}

const footerLinks = [
  { href: '/archive/', label: 'archive' },
  { href: '/tags/', label: 'tags' },
  { href: '/rss.xml', label: 'rss' },
  { href: '/links/', label: 'links' },
  { href: '/colophon/', label: 'colophon' },
  { href: '/releases/', label: 'releases' },
  { href: '/demo/', label: 'demo' },
  { href: '/tinksoft.nfo', label: '.nfo' },
  { href: '/humans.txt', label: 'humans.txt' },
  { href: 'https://github.com/tinkthemaker/', label: 'github', me: true },
];
const canonical = new URL(canonicalPath ?? path, Astro.site);
const siteRoot = new URL('/', Astro.site);
const feed = new URL('/rss.xml', Astro.site);
const sitemap = new URL('/sitemap-index.xml', Astro.site);
const schemaType = type === 'article' ? 'BlogPosting' : path === '/' ? 'WebSite' : 'WebPage';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: schemaType === 'WebSite' ? 'TinkSoft' : pageLabel,
  ...(type === 'article' ? { headline: pageLabel } : {}),
  description,
  url: canonical.href,
  ...(schemaType !== 'WebSite' ? {
    isPartOf: { '@type': 'WebSite', name: 'TinkSoft', url: siteRoot.href },
  } : {}),
  ...(type === 'article' ? {
    datePublished: publishedAt?.toISOString(),
    keywords: tags,
    author: { '@type': 'Person', name: 'Tink', url: new URL('/about/', Astro.site).href },
  } : {}),
}).replace(/</g, '\\u003c');
// The pixel diamond, as public/favicon.svg: gold edges and an ember core on the page colour.
const favicon = 'data:image/svg+xml,' + encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 7 7' shape-rendering='crispEdges'>"
  + '<style>.b{fill:#b99568}.g{fill:#3f2909}.c{fill:#6b130a}@media(prefers-color-scheme:dark){.b{fill:#1c130c}.g{fill:#d6a94e}.c{fill:#e8893a}}</style>'
  + "<rect class='b' width='7' height='7'/><path class='g' d='M3 1h1v1H3zM2 2h3v1H2zM1 3h2v1H1zM4 3h2v1H4zM2 4h3v1H2zM3 5h1v1H3z'/>"
  + "<rect class='c' x='3' y='3' width='1' height='1'/></svg>"
);
const themeStyle = `<style>${themeCss({ ...ART, torches: TORCHES })}</style>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Tink" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="TinkSoft posts" href={feed} />
  <link rel="sitemap" type="application/xml" title="TinkSoft sitemap" href={sitemap} />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'" />
  <link rel="preload" href="/fonts/grenze-gotisch-700.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#b99568" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1c130c" media="(prefers-color-scheme: dark)" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="TinkSoft" />
  <meta property="og:locale" content="en_US" />
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
  {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script is:inline type="application/ld+json" set:html={structuredData}></script>
  <Fragment set:html={themeStyle} />
  <style is:global>
    @font-face {
      font-family: "Grenze Gotisch";
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('/fonts/grenze-gotisch-700.woff2') format('woff2');
    }
    @font-face {
      font-family: "Silkscreen";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/silkscreen-400.woff2') format('woff2');
    }
    :root {
      --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, "URW Palladio L", P052, Georgia, serif;
      --mono: ui-monospace, "Cascadia Mono", "SFMono-Regular", Consolas, "Liberation Mono", "Courier New", monospace;
      --f-display: "Grenze Gotisch", var(--serif);
      --f-plate: "Silkscreen", var(--mono);
    }
    /* Colour tokens come from src/lib/theme.mjs, inlined just above this style. */
    * { box-sizing: border-box; }
    html {
      background:
        repeating-conic-gradient(color-mix(in srgb, var(--ink) var(--grain), transparent) 0 25%, transparent 0 50%) 0 0 / 4px 4px,
        var(--bg);
      scroll-behavior: smooth;
    }
    body {
      margin: 0 auto;
      max-width: 68rem;
      padding: 0 1.25rem 3rem;
      font-family: var(--mono);
      font-size: 16px;
      line-height: 1.6;
      color: var(--ink);
      overflow-wrap: break-word;
    }
    body::before {
      content: '';
      display: block;
      height: 28px;
      margin: 0 -1.25rem;
      background: var(--strip) 0 0 / 32px 28px repeat-x;
      image-rendering: pixelated;
    }
    ::selection { background: var(--hi-bg); color: var(--hi-ink); }
    a {
      color: var(--link);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
    a:visited { color: var(--visited); }
    /* The site's one deliberate !important: page-scoped link colours must never beat the highlight. */
    a:hover, a:focus-visible { color: var(--hi-ink) !important; background-color: var(--hi-bg) !important; text-decoration: none; box-shadow: 0 0 0 2px var(--hi-bg); outline: none; }
    a:focus-visible { box-shadow: 0 0 0 2px var(--hi-bg), 0 0 0 4px var(--hi-ink); }
    a:is(:hover, :focus-visible) * { color: inherit !important; }
    :focus-visible { outline: 2px solid var(--torch); outline-offset: 3px; }
    .skip {
      position: fixed;
      z-index: 20;
      left: -9999px;
    }
    .skip:focus {
      left: 0.75rem;
      top: 0.75rem;
      padding: 0.4rem 0.65rem;
      color: var(--ink);
      background: var(--bg);
      border: 2px solid var(--accent);
    }
    h1, h2, h3 { font-family: inherit; line-height: 1.18; text-wrap: balance; }
    h1 {
      margin: 0 0 0.8rem;
      font: 700 clamp(36px, 7vw, 54px)/1.02 var(--f-display);
      font-synthesis: none;
    }
    h1::first-letter { color: var(--rubric); }
    h2 {
      margin-top: 2.4rem;
      font-size: 1.25rem;
    }
    /* The pixel diamond, the site's one ornament: a 5x5 diamond of box-shadow pixels, gold edges, ember core. */
    .gem, main > h2:not(.plate, .scene-label)::before, .content > h2::before {
      --p: 3px;
      display: inline-block;
      width: var(--p);
      height: var(--p);
      margin: calc(var(--p) * 2) calc(var(--p) * 2.5);
      vertical-align: middle;
      background: var(--torch);
      box-shadow:
        0 calc(var(--p) * -2) var(--gold),
        calc(var(--p) * -1) calc(var(--p) * -1) var(--gold), 0 calc(var(--p) * -1) var(--gold), var(--p) calc(var(--p) * -1) var(--gold),
        calc(var(--p) * -2) 0 var(--gold), calc(var(--p) * -1) 0 var(--gold), var(--p) 0 var(--gold), calc(var(--p) * 2) 0 var(--gold),
        calc(var(--p) * -1) var(--p) var(--gold), 0 var(--p) var(--gold), var(--p) var(--p) var(--gold),
        0 calc(var(--p) * 2) var(--gold);
    }
    .gem.sm { --p: 2px; }
    main > h2:not(.plate, .scene-label)::before, .content > h2::before { content: ''; margin: 0 calc(var(--p) * 4) 0 calc(var(--p) * 2); }
    @media (prefers-color-scheme: light) {
      .gem, main > h2:not(.plate, .scene-label)::before, .content > h2::before { background: var(--rubric); }
    }
    .divider { display: flex; align-items: center; gap: 12px; margin: 2.5rem 0; }
    .divider::before, .divider::after, hr {
      content: '';
      flex: 1;
      height: 4px;
      background: repeating-conic-gradient(var(--gold) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    }
    h3 { margin-top: 1.75rem; font-family: var(--serif); font-size: 1.05rem; font-weight: bold; color: var(--torch); }
    p { max-width: 76ch; }
    hr { border: none; margin: 1.75rem 0; }
    main { min-width: 0; }
    .system-bar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.45rem 0;
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .system-state { white-space: nowrap; }
    .system-bar > span { white-space: nowrap; }
    .led {
      display: inline-block;
      width: 0.55rem;
      height: 0.55rem;
      margin-right: 0.35rem;
      border-radius: 50%;
      background: var(--ship);
      box-shadow: 0 0 0 2px var(--panel-2);
    }
    /* Masthead: a riveted stone frame holding the corridor viewport, the wordmark and the telemetry. */
    .masthead {
      --rivet: radial-gradient(circle, var(--gold) 0 2px, var(--shadow) 2px 3px, transparent 3.5px);
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 26px;
      align-items: center;
      padding: 14px 16px;
      overflow: hidden; /* keeps the wordmark glow inside the frame on narrow screens */
      border: 6px ridge var(--frame);
      background:
        var(--rivet) left 3px top 3px / 10px 10px no-repeat,
        var(--rivet) right 3px top 3px / 10px 10px no-repeat,
        var(--rivet) left 3px bottom 3px / 10px 10px no-repeat,
        var(--rivet) right 3px bottom 3px / 10px 10px no-repeat,
        var(--panel);
      box-shadow: 4px 4px 0 var(--shadow);
    }
    /* The dithered corridor, always at exactly 2x. Decorative: no role, no label. */
    .viewport {
      position: relative;
      box-sizing: content-box;
      width: 240px;
      height: 160px;
      background: var(--scene) 0 0 / 240px 160px no-repeat, var(--panel-2);
      image-rendering: pixelated;
      border: 3px double var(--gold);
      box-shadow: 0 0 0 2px var(--shadow);
    }
    /* Torch flicker: hard-edged dithered halos stepping between radii, night only. */
    @property --r { syntax: '<percentage>'; inherits: false; initial-value: 9%; }
    .viewport::before, .viewport::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-conic-gradient(#ffc66b 0 25%, transparent 0 100%) 0 0 / 4px 4px;
      -webkit-mask: radial-gradient(circle at var(--torch-l), #000 0 var(--r), transparent var(--r));
      mask: radial-gradient(circle at var(--torch-l), #000 0 var(--r), transparent var(--r));
      opacity: 0.5;
      animation: flicker 1.9s steps(1) infinite;
    }
    .viewport::after {
      -webkit-mask: radial-gradient(circle at var(--torch-r), #000 0 var(--r), transparent var(--r));
      mask: radial-gradient(circle at var(--torch-r), #000 0 var(--r), transparent var(--r));
      animation-duration: 2.3s;
      animation-delay: -0.7s;
    }
    @keyframes flicker {
      0% { --r: 9%; opacity: 0.5; }
      18% { --r: 11%; opacity: 0.62; }
      34% { --r: 8%; opacity: 0.42; }
      52% { --r: 10%; opacity: 0.58; }
      77% { --r: 7.5%; opacity: 0.45; }
    }
    @media (prefers-color-scheme: light) {
      .viewport::before, .viewport::after { display: none; }
    }
    .titleblock { min-width: 0; }
    /* A two-step dithered torch glow behind the word: sparse outer ring, denser core, hard edges. */
    .wordmark-glow { position: relative; isolation: isolate; display: inline-block; }
    .wordmark-glow::before, .wordmark-glow::after {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -16px -36px -12px -30px;
      pointer-events: none;
    }
    .wordmark-glow::before {
      background: conic-gradient(at 2px 2px, transparent 75%, var(--glow) 0) 0 0 / 6px 6px;
      -webkit-mask: radial-gradient(ellipse 50% 50% at 50% 52%, #000 99%, transparent 100%);
      mask: radial-gradient(ellipse 50% 50% at 50% 52%, #000 99%, transparent 100%);
    }
    .wordmark-glow::after {
      background: repeating-conic-gradient(var(--glow) 0 25%, transparent 0 100%) 0 0 / 4px 4px;
      -webkit-mask: radial-gradient(ellipse 34% 30% at 50% 52%, #000 99%, transparent 100%);
      mask: radial-gradient(ellipse 34% 30% at 50% 52%, #000 99%, transparent 100%);
    }
    /* The wordmark: molten gold at night, an ink stamp by day. Real text, clipped to banded fills. */
    .wordmark, .wordmark:hover, .wordmark:focus-visible {
      display: inline-block;
      padding: 0 0.1em 0.06em 0;
      font: 700 clamp(48px, 6.6vw, 84px)/0.98 var(--f-display);
      font-synthesis: none;
      letter-spacing: 0.01em;
      text-decoration: none;
      color: var(--wm-3);
      background:
        repeating-conic-gradient(var(--wm-2) 0 25%, transparent 0 50%) 0 27% / 4px 4px repeat-x,
        repeating-conic-gradient(var(--wm-3) 0 25%, transparent 0 50%) 0 45% / 4px 4px repeat-x,
        repeating-conic-gradient(var(--wm-4) 0 25%, transparent 0 50%) 0 63% / 4px 4px repeat-x,
        repeating-conic-gradient(var(--wm-5) 0 25%, transparent 0 50%) 0 80% / 4px 4px repeat-x,
        linear-gradient(180deg, var(--wm-1) 0 28%, var(--wm-2) 28% 46%, var(--wm-3) 46% 64%, var(--wm-4) 64% 81%, var(--wm-5) 81%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: var(--wm-filter);
      box-shadow: none;
    }
    .wordmark .ini { -webkit-text-fill-color: var(--wm-initial); }
    .wordmark:hover { filter: var(--wm-filter) brightness(1.15) saturate(1.1); }
    .wordmark:focus-visible { outline: 2px dashed var(--torch); outline-offset: 6px; }
    /* One 2px gold line exactly as wide as the wordmark, breaking into a short dithered tail. */
    .title-rule {
      position: relative;
      display: block;
      height: 4px;
      margin: 4px 0 8px;
      background: linear-gradient(var(--gold) 0 0) 0 1px / calc(100% - 24px) 2px no-repeat;
    }
    .title-rule::before, .title-rule::after { content: ''; position: absolute; top: 0; height: 4px; }
    .title-rule::before { right: 8px; width: 16px; background: repeating-conic-gradient(var(--gold) 0 25%, transparent 0 50%) 0 0 / 4px 4px; }
    .title-rule::after { right: 0; width: 8px; background: repeating-conic-gradient(var(--gold) 0 25%, transparent 0 100%) 0 0 / 4px 4px; }
    .tagline { margin: 0; color: var(--muted); font: italic 15.5px/1.4 var(--serif); }
    .telemetry {
      margin: 0;
      padding-left: 1rem;
      border-left: 3px double var(--rule);
      font-size: 0.68rem;
      line-height: 1.55;
      text-transform: uppercase;
    }
    .telemetry div { display: grid; grid-template-columns: auto auto; gap: 1rem; }
    .telemetry dt { color: var(--muted); }
    .telemetry dd { margin: 0; color: var(--torch); text-align: right; }
    nav.site {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 0.5rem;
      margin-top: 0.9rem;
      padding: 0.55rem 0.75rem;
      border-block: 1px solid var(--rule);
      background: var(--panel);
      letter-spacing: 0.02em;
      font-size: 0.86rem;
    }
    .navitem { display: inline-block; white-space: nowrap; }
    nav.site a[aria-current='page'] {
      color: var(--hi-ink);
      background: var(--hi-bg);
      box-shadow: 0 0 0 2px var(--hi-bg);
      text-decoration: none;
      font-weight: bold;
    }
    nav.thread {
      margin: 0.85rem 0 2rem;
      color: var(--muted);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.045em;
    }
    nav.thread::before { content: 'PATH :: '; color: var(--torch); font-weight: bold; }
    nav.thread ol { display: inline-flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
    nav.thread li:not(:last-child)::after { content: ' /'; color: var(--rule); }
    nav.thread [aria-current='page'] { color: var(--ink); font-weight: bold; }
    /* Panels: a double rule frame and a hard shadow. Featured panels (.window) get a gold frame. */
    .scene-panel, .footer-grid, nav.post-nav p, .window {
      border: 3px double var(--rule);
      background: var(--panel);
      box-shadow: 4px 4px 0 var(--shadow);
    }
    .window { border-color: var(--gold); }
    .scene-panel { position: relative; padding: 1.25rem; }
    /* Section plates: a gold label in pixel type whose right edge dithers away. Brackets are gone. */
    .plate, .scene-label {
      position: relative;
      display: inline-block;
      margin: 0;
      padding: 3px 12px 2px;
      color: var(--bg);
      background: var(--gold);
      /* Silkscreen has one weight, so 700 + no synthesis keeps it at 400; the mono fallback renders bold. */
      font: 700 16px/1.3 var(--f-plate);
      font-synthesis: none;
      letter-spacing: 0;
      text-transform: uppercase;
    }
    .plate::before, .plate::after, .scene-label::before, .scene-label::after { content: ''; position: absolute; top: 0; bottom: 0; }
    .plate::after, .scene-label::after { left: 100%; width: 16px; background: repeating-conic-gradient(var(--gold) 0 25%, transparent 0 50%) 0 0 / 4px 4px; }
    .plate::before, .scene-label::before { left: calc(100% + 16px); width: 12px; background: repeating-conic-gradient(var(--gold) 0 25%, transparent 0 100%) 0 0 / 4px 4px; }
    .scene-label { margin: -2rem 0 0.85rem -0.5rem; }
    .eyebrow { color: var(--gold); font-size: 0.75rem; font-weight: bold; letter-spacing: 0.08em; text-transform: uppercase; }
    .action {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--rule);
      background: var(--panel);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: bold;
    }
    table.log { width: 100%; border-collapse: collapse; }
    table.log tr { border-bottom: 1px dotted var(--rule); }
    table.log td { padding: 0.65rem 0.75rem 0.65rem 0; vertical-align: top; }
    /* List rows: tint and an ember bar on hover. Never --panel-2, which can't carry text by day. */
    table.log tr:hover, .row-hover:hover { background: color-mix(in srgb, var(--panel) 70%, transparent); box-shadow: inset 3px 0 0 var(--torch); }
    td.date { white-space: nowrap; color: var(--muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
    .post-meta { color: var(--muted); font-size: 0.82rem; }
    nav.post-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    nav.post-nav p { margin: 0; padding: 0.75rem; }
    /* Prose: an old-style serif with blackletter headings and an illuminated first letter. */
    .content { max-width: 50rem; font: 17.5px/1.62 var(--serif); }
    .content > h2 { font: 700 1.55em/1.1 var(--f-display); font-synthesis: none; }
    .content strong { color: var(--torch); }
    .content :is(code, pre) { font-family: var(--mono); }
    .content :is(pre) {
      /* Shiki's css-variables theme: an amber CRT in both schemes. Unset tokens fall back to the foreground. */
      --astro-code-foreground: var(--code-ink);
      --astro-code-background: var(--code-bg);
      --astro-code-token-comment: #a99070;
      --astro-code-token-keyword: #e8893a;
      --astro-code-token-string: #f0c060;
      --astro-code-token-function: #ffe3a3;
      --astro-code-token-constant: #f0ac55;
      padding: 1rem;
      overflow-x: auto;
      color: var(--code-ink);
      background: var(--code-bg);
      border: 1px solid var(--frame);
      box-shadow: 3px 3px 0 var(--shadow);
      text-shadow: 0 0 6px color-mix(in srgb, var(--code-ink) 35%, transparent);
      font-size: 0.84rem;
      line-height: 1.5;
    }
    .content :is(code):not(pre code) { padding: 0.08rem 0.3rem; background: var(--code-bg); color: var(--code-ink); font-size: 0.86em; }
    .content blockquote { margin-left: 0; padding: 0.3rem 0 0.3rem 1rem; border-left: 4px solid var(--rubric); color: var(--quote-ink); font-style: italic; }
    .content img { max-width: 100%; height: auto; border: 1px solid var(--rule); }
    .dropcap::first-letter, .content > p:first-child::first-letter {
      float: left;
      margin: 4px 10px 0 0;
      padding: 4px 8px 2px;
      font: 700 3.1em/0.9 var(--f-display);
      color: var(--rubric);
      border: 1px solid var(--gold);
      box-shadow: 2px 2px 0 var(--shadow);
      background: var(--bg) repeating-conic-gradient(color-mix(in srgb, var(--gold) 30%, transparent) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    }
    footer { margin-top: 4rem; color: var(--muted); font-size: 0.76rem; }
    footer > .divider { margin: 0 0 1rem; }
    .footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; padding: 1rem; }
    .footer-heading { margin: 0 0 0.55rem; color: var(--accent); font-weight: bold; letter-spacing: 0.06em; }
    .footer-grid p { margin: 0.35rem 0; }
    .badge { display: inline-block; margin: 0 0.35rem 0.35rem 0; padding: 0.08rem 0.4rem; border: 1px solid var(--rule); background: var(--badge-bg); color: var(--ink); font-size: 0.67rem; }
    .footer-end { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.8rem; }
    img.counter { vertical-align: middle; border: 1px solid var(--rule); image-rendering: pixelated; }
    .return { margin-bottom: 1rem; }
    .status-ship { color: var(--ship); font-weight: bold; }
    .status-wip { color: var(--wip); font-weight: bold; }
    .status-idea { color: var(--muted); font-weight: bold; }
    @media (max-width: 48rem) {
      body { padding-inline: 0.8rem; }
      body::before { margin-inline: -0.8rem; }
      .system-bar { font-size: 0.62rem; }
      .masthead { grid-template-columns: 1fr; justify-items: start; gap: 18px; padding: 0.85rem; box-shadow: 3px 3px 0 var(--shadow); }
      .telemetry { display: none; }
      .tagline { font-size: 14px; }
      nav.site { margin-top: 0.65rem; padding: 0.45rem 0.55rem; gap: 0.2rem 0.42rem; font-size: 0.78rem; }
      nav.thread { margin-bottom: 1.5rem; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-end { display: block; }
    }
    @media (max-width: 30rem) {
      .system-bar { gap: 0.5rem; font-size: 0.58rem; }
      table.log, table.log tbody, table.log tr, table.log td { display: block; }
      table.log td { padding: 0; }
      table.log tr { padding: 0.75rem 0; }
      table.log tr + tr { margin-top: 0.35rem; }
      nav.post-nav { grid-template-columns: 1fr; }
      .scene-panel { padding: 1rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .viewport::before, .viewport::after { animation: none; }
    }
    /* Windows high contrast: a clipped, transparent-filled wordmark would vanish. */
    @media (forced-colors: active) {
      .wordmark { -webkit-text-fill-color: currentColor; background: none; filter: none; }
      .wordmark:is(:hover, :focus-visible), .wordmark .ini { -webkit-text-fill-color: currentColor; background: none; filter: none; }
      .wordmark-glow::before, .wordmark-glow::after { display: none; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">skip to content</a>
  <header>
    <div class="system-bar">
      <span>TINKSOFT // PUBLIC NODE 01</span>
      <span class="system-state"><span class="led" aria-hidden="true"></span>ONLINE &middot; STATIC</span>
    </div>
    <div class="masthead">
      <div class="viewport" aria-hidden="true"></div>
      <div class="titleblock">
        <span class="wordmark-glow">
          <a class="wordmark" href="/"><span class="ini">T</span>inkSoft</a>
          <span class="title-rule" aria-hidden="true"></span>
        </span>
        <p class="tagline">software, security, games, and whatever else interests me.</p>
      </div>
      <dl class="telemetry" aria-label="site telemetry">
        <div><dt>mode</dt><dd>personal</dd></div>
        <div><dt>output</dt><dd>static html</dd></div>
        <div><dt>client</dt><dd>0 kb js</dd></div>
        <div><dt>tracking</dt><dd>none</dd></div>
      </dl>
    </div>
    <nav class="site" aria-label="site">
      {nav.map((item) => (
        <span class="navitem">[<a
          href={item.href}
          aria-current={isHere(item.section) ? 'page' : undefined}
        >{item.label}</a>]</span>
      ))}
      <span class="navitem">[<a href="https://github.com/tinkthemaker/" rel="me">github</a>]</span>
    </nav>
  </header>

  <nav class="thread" aria-label="page trail">
    <ol>
      {thread.map((item, index) => (
        <li>
          {index === thread.length - 1
            ? <span aria-current="page">{item.label}</span>
            : <a href={item.href}>{item.label}</a>}
        </li>
      ))}
    </ol>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    {path !== '/' && <p class="return"><a href="/">&laquo; return to posts</a></p>}
    <div class="divider" aria-hidden="true"><i class="gem sm"></i><i class="gem"></i><i class="gem sm"></i></div>
    <div class="footer-grid">
      <section aria-labelledby="footer-system">
        <p class="footer-heading" id="footer-system">[SYSTEM]</p>
        <p>
          <span class="badge">PERSONAL SITE</span><span class="badge">PLAIN HTML</span><span class="badge">0 KB JS</span><span class="badge">NO TRACKING</span><span class="badge">EST. 2026</span>
        </p>
        <p>One operator. No platform. Files stay readable.</p>
      </section>
      <section aria-labelledby="footer-links">
        <p class="footer-heading" id="footer-links">[MORE FILES]</p>
        <nav aria-label="more">
          {footerLinks.map((item) => (
            <span class="navitem">[<a href={item.href} rel={item.me ? 'me' : undefined}>{item.label}</a>]</span>
          ))}
        </nav>
      </section>
    </div>
    <p class="footer-end">
      <span>counter: <img class="counter" src="/counter.svg" alt="static counter: 0001337" width="66" height="20" /></span>
      <span>&copy; {new Date().getFullYear()} tinksoft.com &middot; tink &middot; EOF</span>
    </p>
  </footer>
</body>
</html>
