---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'TinkSoft — build logs, bugs, and small victories. Building software in public since 2026.' } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'build log', section: ['/', '/log'] },
  { href: '/projects/', label: 'projects', section: ['/projects'] },
  { href: '/now/', label: 'now', section: ['/now'] },
  { href: '/about/', label: 'about', section: ['/about'] },
];
const isHere = (section: string[]) =>
  section.some((s) => (s === '/' ? path === '/' : path.startsWith(s)));

const footerLinks = [
  { href: '/rss.xml', label: 'rss' },
  { href: '/links/', label: 'links' },
  { href: '/colophon/', label: 'colophon' },
  { href: '/tinksoft.nfo', label: '.nfo' },
  { href: '/humans.txt', label: 'humans.txt' },
  { href: 'https://github.com/tinkthemaker/', label: 'github', me: true },
];
const canonical = new URL(path, Astro.site);
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cstyle%3Erect%7Bfill:%23f4f0e4%7Dtext%7Bfill:%23008080%7D@media(prefers-color-scheme:dark)%7Brect%7Bfill:%23161613%7Dtext%7Bfill:%233fbdb0%7D%7D%3C/style%3E%3Crect width='32' height='32'/%3E%3Ctext x='16' y='23' font-family='monospace' font-size='20' font-weight='bold' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="TinkSoft build log" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#f4f0e4" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161613" media="(prefers-color-scheme: dark)" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <style is:global>
    :root {
      --bg: #f4f0e4;
      --ink: #1a1a1a;
      --link: #0000cc;
      --visited: #551a8b;
      --rule: #888;
      --accent: #008080;
      --muted: #555;
      --badge-bg: #e4ddc8;
      --code-bg: #1a1a1a;
      --code-ink: #33ff33;
      --quote-ink: #444;
      --ship: #006600;
      --wip: #b35900;
      color-scheme: light dark;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #161613;
        --ink: #d6d2c4;
        --link: #7da7ff;
        --visited: #c39be8;
        --rule: #555;
        --accent: #3fbdb0;
        --muted: #9a968a;
        --badge-bg: #26261f;
        --code-bg: #0c0c0c;
        --code-ink: #33ff33;
        --quote-ink: #b0aca0;
        --ship: #5dbb63;
        --wip: #e0a050;
      }
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); }
    body {
      margin: 0 auto;
      max-width: 44rem;
      padding: 1.5rem 1rem 3rem;
      font-family: "Courier New", Courier, monospace;
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink);
      overflow-wrap: break-word;
    }
    a { color: var(--link); }
    a:visited { color: var(--visited); }
    a:hover { background: var(--ink); color: var(--bg); }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .skip {
      position: absolute;
      left: -9999px;
    }
    .skip:focus {
      left: 0.5rem;
      top: 0.5rem;
      padding: 0.25rem 0.5rem;
      background: var(--bg);
      border: 1px solid var(--rule);
    }
    h1, h2, h3 { font-family: inherit; line-height: 1.2; }
    h1 { font-size: 1.5rem; }
    h2 { font-size: 1.2rem; margin-top: 2rem; }
    hr {
      border: none;
      border-top: 1px solid var(--rule);
      margin: 1.5rem 0;
    }
    pre.ascii {
      font-size: clamp(6px, 1.9vw, 13px);
      line-height: 1.15;
      overflow: hidden;
      margin: 0;
      color: var(--accent);
      user-select: none;
    }
    nav.site {
      margin-top: 0.75rem;
      letter-spacing: 0.02em;
    }
    a.logo { display: inline-block; }
    a.logo:hover { background: none; color: inherit; }
    .navitem { display: inline-block; margin-right: 0.5rem; white-space: nowrap; }
    nav.site a[aria-current='page'] {
      color: var(--ink);
      text-decoration: none;
      font-weight: bold;
    }
    .tagline { color: var(--muted); margin: 0.5rem 0 0; font-size: 0.9rem; }
    table.log { border-collapse: collapse; width: 100%; }
    table.log td { padding: 0.3rem 0.75rem 0.3rem 0; vertical-align: top; }
    td.date { white-space: nowrap; color: var(--muted); font-size: 0.9rem; }
    @media (max-width: 30rem) {
      table.log, table.log tbody, table.log tr, table.log td { display: block; }
      table.log td { padding: 0; }
      table.log tr + tr { margin-top: 0.9rem; }
    }
    .post-meta { color: var(--muted); font-size: 0.9rem; }
    nav.post-nav p { margin: 0.3rem 0; }
    .content :is(pre) {
      background: var(--code-bg);
      color: var(--code-ink);
      padding: 0.75rem 1rem;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.4;
    }
    .content :is(code):not(pre code) {
      background: var(--badge-bg);
      padding: 0 0.25rem;
    }
    .content blockquote {
      border-left: 3px solid var(--accent);
      margin-left: 0;
      padding-left: 1rem;
      color: var(--quote-ink);
    }
    .content img { max-width: 100%; height: auto; border: 1px solid var(--rule); }
    footer {
      margin-top: 3rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
    .badge {
      display: inline-block;
      border: 1px solid var(--rule);
      background: var(--badge-bg);
      padding: 0 0.4rem;
      font-size: 0.75rem;
      margin: 0 0.4rem 0.3rem 0;
    }
    img.counter {
      vertical-align: middle;
      border: 1px solid var(--rule);
    }
    .status-ship { color: var(--ship); font-weight: bold; }
    .status-wip { color: var(--wip); font-weight: bold; }
    .status-idea { color: var(--muted); }
  </style>
</head>
<body>
  <a class="skip" href="#main">skip to content</a>
  <header>
    <a class="logo" href="/" aria-label="TinkSoft home" style="text-decoration:none"><pre class="ascii" aria-hidden="true">
 _____ ___ _   _ _  ______   ___  _____ _____
|_   _|_ _| \ | | |/ / ___| / _ \|  ___|_   _|
  | |  | ||  \| | ' /\___ \| | | | |_    | |
  | |  | || |\  | . \ ___) | |_| |  _|   | |
  |_| |___|_| \_|_|\_\____/ \___/|_|     |_|</pre></a>
    <p class="tagline">// building software in public. logs, bugs, small victories. est. 2026</p>
    <nav class="site" aria-label="site">
      {nav.map((item) => (
        <span class="navitem">[<a
          href={item.href}
          aria-current={isHere(item.section) ? 'page' : undefined}
        >{item.label}</a>]</span>
      ))}
      <span class="navitem">[<a href="https://github.com/tinkthemaker/" rel="me">github</a>]</span>
    </nav>
    <hr />
  </header>

  <main id="main">
    <slot />
  </main>

  <footer>
    <hr />
    <p>
      <span class="badge">EST. 2026</span><span class="badge">100% HTML</span><span class="badge">0 KB JS</span><span class="badge">1 REQUEST + COUNTER</span><span class="badge">best viewed in any browser</span>
    </p>
    <nav aria-label="more">
      {footerLinks.map((item) => (
        <span class="navitem">[<a href={item.href} rel={item.me ? 'me' : undefined}>{item.label}</a>]</span>
      ))}
    </nav>
    <p>you are visitor No. <img class="counter" src="/counter.svg" alt="visitor counter, frozen at 0001337" width="66" height="20" /> &middot; &copy; {new Date().getFullYear()} tinksoft.com &middot; made by tink</p>
  </footer>
</body>
</html>
