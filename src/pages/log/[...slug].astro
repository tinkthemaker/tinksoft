---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { tagPath } from '../../lib/content.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  const projects = await getCollection('projects');
  return posts.map((post, i) => {
    const postTags = new Set(post.data.tags);
    const relatedPosts = posts
      .filter((candidate) => candidate.id !== post.id && candidate.data.tags.some((tag) => postTags.has(tag)))
      .slice(0, 3);
    const relatedProjects = projects.filter(
      (project) => project.data.tag && postTags.has(project.data.tag)
    );
    return {
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1], relatedPosts, relatedProjects },
    };
  });
}

const { post, newer, older, relatedPosts, relatedProjects } = Astro.props;
const { Content, headings } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.ceil(words / 220));
const sections = headings.filter((heading) => heading.depth === 2);
---
<Base
  title={`${post.data.title} — TinkSoft`}
  description={post.data.description}
  type="article"
  publishedAt={post.data.date}
  tags={post.data.tags}
>
  <header class="post-head scene-panel">
    <p class="scene-label">[TRANSMISSION]</p>
    <p class="eyebrow">FILE // {post.id}.txt</p>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="dek">{post.data.description}</p>}
    <dl class="post-facts">
      <div><dt>date</dt><dd><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></dd></div>
      <div><dt>read</dt><dd>{minutes} min / {words} words</dd></div>
      <div><dt>format</dt><dd><a href={`/log/${post.id}.txt`}>plain text</a></dd></div>
    </dl>
    {post.data.tags.length > 0 && (
      <nav class="tag-row" aria-label="post tags">
        {post.data.tags.map((tag) => <a href={`/tags/${tagPath(tag)}/`}>#{tag}</a>)}
      </nav>
    )}
  </header>

  <div class:list={['post-layout', { 'has-sections': sections.length > 1 }]}>
    {sections.length > 1 && (
      <aside class="contents scene-panel" aria-labelledby="contents-title">
        <p class="scene-label" id="contents-title">[IN THIS FILE]</p>
        <ol>
          {sections.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </aside>
    )}
    <article class="content prose">
      <Content />
    </article>
  </div>

  {(relatedPosts.length > 0 || relatedProjects.length > 0) && (
    <section class="connections scene-panel" aria-labelledby="connected-files">
      <h2 class="scene-label" id="connected-files">[CONNECTED FILES]</h2>
      <div class="connections-grid">
        {relatedProjects.length > 0 && (
          <section aria-labelledby="connected-projects">
            <h3 id="connected-projects">project files</h3>
            <ul>
              {relatedProjects.map((project) => (
                <li>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  <span>{project.data.description}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {relatedPosts.length > 0 && (
          <section aria-labelledby="related-posts">
            <h3 id="related-posts">related posts</h3>
            <ul>
              {relatedPosts.map((related) => (
                <li>
                  <a href={`/log/${related.id}/`}>{related.data.title}</a>
                  <time datetime={related.data.date.toISOString()}>{fmt(related.data.date)}</time>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </section>
  )}

  {(newer || older) && (
    <>
      <hr />
      <nav class="post-nav" aria-label="nearby entries">
        {older && <p>&laquo; older: <a href={`/log/${older.id}/`}>{older.data.title}</a></p>}
        {newer && <p>newer: <a href={`/log/${newer.id}/`}>{newer.data.title}</a> &raquo;</p>}
      </nav>
    </>
  )}

  <style>
    .post-head { margin-bottom: 2.25rem; border-left: 4px solid var(--accent); }
    .post-head h1 { max-width: 22ch; margin: 0.3rem 0 0.65rem; }
    .dek { max-width: 58ch; margin: 0; color: var(--muted); font-size: 1.02rem; }
    .post-facts { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin: 1.25rem 0 0; padding-top: 0.75rem; border-top: 1px dotted var(--rule); font-size: 0.76rem; }
    .post-facts div { display: grid; grid-template-columns: auto auto; gap: 0.55rem; }
    .post-facts dt { color: var(--muted); text-transform: uppercase; }
    .post-facts dd { margin: 0; color: var(--ink); }
    .tag-row { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.9rem; }
    .tag-row a { padding: 0.08rem 0.4rem; border: 1px solid var(--rule); background: var(--panel-2); font-size: 0.72rem; text-decoration: none; }
    .post-layout { display: grid; gap: 2rem; }
    .post-layout.has-sections { grid-template-columns: minmax(0, 1fr) 13rem; align-items: start; }
    .prose { grid-column: 1; grid-row: 1; }
    .contents { grid-column: 2; grid-row: 1; position: sticky; top: 1rem; padding: 1rem; box-shadow: 3px 3px 0 var(--shadow); font-size: 0.74rem; }
    .contents ol { margin: 0; padding-left: 1.3rem; }
    .contents li + li { margin-top: 0.45rem; }
    .prose :global(h2) { scroll-margin-top: 1rem; }
    .prose :global(p), .prose :global(li) { max-width: 70ch; }
    .connections { margin-top: 2.25rem; }
    .connections-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem; }
    .connections h3 { margin: 0 0 0.6rem; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .connections ul { margin: 0; padding: 0; list-style: none; }
    .connections li { padding: 0.45rem 0; border-bottom: 1px dotted var(--rule); }
    .connections li span { display: block; color: var(--muted); font-size: 0.78rem; }
    .connections time { display: block; color: var(--muted); font-size: 0.72rem; font-variant-numeric: tabular-nums; }
    @media (max-width: 52rem) {
      .post-layout.has-sections { grid-template-columns: 1fr; }
      .contents { grid-column: 1; grid-row: 1; position: static; }
      .prose { grid-row: 2; }
    }
    @media (max-width: 32rem) {
      .post-head { padding: 1rem; }
      .post-facts { display: grid; gap: 0.35rem; }
    }
  </style>
</Base>
