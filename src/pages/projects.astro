---
import Base from '../layouts/Base.astro';

// Edit this list as projects come and go.
// status: 'shipped' | 'wip' | 'idea'
const projects = [
  {
    name: 'tinksoft.com',
    status: 'wip',
    description: 'This site. A 90s-style build log for working in public.',
    link: '/',
  },
  {
    name: 'your next project',
    status: 'idea',
    description: 'Replace this entry in src/pages/projects.astro.',
    link: null,
  },
];

const statusLabel = {
  shipped: { text: '[SHIPPED]', cls: 'status-ship' },
  wip: { text: '[WIP]', cls: 'status-wip' },
  idea: { text: '[IDEA]', cls: 'status-idea' },
};
---
<Base title="projects — TinkSoft">
  <h1>projects</h1>
  <p>What's on the workbench, what made it out the door, and what's still a sketch.</p>

  {projects.map((p) => (
    <>
      <h2>
        <span class={statusLabel[p.status].cls}>{statusLabel[p.status].text}</span>{' '}
        {p.link ? <a href={p.link}>{p.name}</a> : p.name}
      </h2>
      <p>{p.description}</p>
    </>
  ))}
</Base>
