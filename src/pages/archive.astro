---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tagPath } from '../lib/content.mjs';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const monthName = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  timeZone: 'UTC',
});
const fullDate = new Intl.DateTimeFormat('en-US', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const years = new Map<string, Map<string, typeof posts>>();

for (const post of posts) {
  const year = String(post.data.date.getUTCFullYear());
  const month = String(post.data.date.getUTCMonth()).padStart(2, '0');
  if (!years.has(year)) years.set(year, new Map());
  const months = years.get(year)!;
  if (!months.has(month)) months.set(month, []);
  months.get(month)!.push(post);
}
---
<Base
  title="archive — TinkSoft"
  description="Every TinkSoft post, arranged by year and month."
>
  <header class="page-head">
    <p class="eyebrow">[FULL INDEX]</p>
    <h1>archive</h1>
    <p>{posts.length} file{posts.length === 1 ? '' : 's'}, newest first. Browse by <a href="/tags/">tag</a>.</p>
  </header>

  {Array.from(years).map(([year, months]) => (
    <section class="year" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`}><span aria-hidden="true">// </span>{year}</h2>
      {Array.from(months).map(([month, monthPosts]) => {
        const date = new Date(Date.UTC(Number(year), Number(month), 1));
        const monthId = `month-${year}-${month}`;
        return (
          <section class="month" aria-labelledby={monthId}>
            <h3 id={monthId}>
              <span>{monthName.format(date)}</span>
              <span class="count">{String(monthPosts.length).padStart(2, '0')} file{monthPosts.length === 1 ? '' : 's'}</span>
            </h3>
            <ol class="entries">
              {monthPosts.map((post) => (
                <li>
                  <time datetime={post.data.date.toISOString()}>{fullDate.format(post.data.date)}</time>
                  <div>
                    <a class="title" href={`/log/${post.id}/`}>{post.data.title}</a>
                    {post.data.description && <p>{post.data.description}</p>}
                    {post.data.tags.length > 0 && (
                      <ul class="tags" aria-label="tags">
                        {post.data.tags.map((tag) => (
                          <li><a href={`/tags/${tagPath(tag)}/`}>#{tag}</a></li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </section>
  ))}

  {posts.length === 0 && <p><em>No files in the archive.</em></p>}

  <style>
    .page-head { margin-bottom: 2rem; }
    .page-head h1 { margin: 0.15rem 0 0.5rem; }
    .page-head p:last-child { margin-bottom: 0; }
    .eyebrow {
      margin: 0;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: bold;
      letter-spacing: 0.12em;
    }
    .year { margin-top: 2.5rem; }
    .year > h2 {
      margin: 0 0 0.8rem;
      color: var(--accent);
      font-size: 1.35rem;
    }
    .year > h2::before { content: none; }
    .month {
      border-left: 1px solid var(--rule);
      margin-left: 0.45rem;
      padding: 0 0 1.7rem 1rem;
    }
    .month:last-child { padding-bottom: 0; }
    .month h3 {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 0.8rem;
      padding-bottom: 0.3rem;
      border-bottom: 1px dashed var(--rule);
      font-size: 1rem;
      text-transform: uppercase;
    }
    .count {
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: normal;
      white-space: nowrap;
    }
    .entries { margin: 0; padding: 0; list-style: none; }
    .entries > li {
      display: grid;
      grid-template-columns: 7.2rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 0.55rem 0;
    }
    time { color: var(--muted); font-size: 0.8rem; white-space: nowrap; }
    .title { font-weight: bold; }
    .entries p { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.9rem; }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.65rem;
      margin: 0.25rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 0.75rem;
    }
    .tags a { color: var(--accent); }
    @media (max-width: 30rem) {
      .entries > li { grid-template-columns: 1fr; gap: 0.05rem; padding: 0.7rem 0; }
      .month { margin-left: 0.2rem; padding-left: 0.75rem; }
      .month h3 { align-items: baseline; }
    }
  </style>
</Base>
