---
import Base from '../layouts/Base.astro';
---
<Base title="404 — TinkSoft" description="There's nothing here.">
  <section class="lost scene-panel">
    <p class="scene-label">[CONNECTION LOST]</p>
    <p class="code">ERROR 404 // NO CARRIER</p>
    <h1>file not found</h1>
    <p>There is nothing at this address. The index is still online.</p>
    <nav aria-label="ways out">
      <a class="action" href="/">posts</a>
      <a class="action" href="/projects/">projects</a>
      <a class="action" href="/archive/">archive</a>
      <a class="action" href="/now/">now</a>
    </nav>
  </section>
  <style>
    .lost { max-width: 44rem; margin: 4rem auto; border-left: 4px solid var(--accent-2); }
    .code { color: var(--accent-2); font-size: 0.8rem; font-weight: bold; letter-spacing: 0.08em; }
    .lost h1 { margin: 0.35rem 0; font-size: clamp(2rem, 8vw, 4rem); }
    .lost nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  </style>
</Base>
