---
import Base from '../layouts/Base.astro';
// Add fellow wizards to the blogroll as you find them.
---
<Base title="links — TinkSoft" description="The good corners of the web.">
  <h1>links</h1>
  <p>
    The old web ran on outbound links, freely given. These are corners of
    the internet I think are worth your afternoon.
  </p>

  <h2>the small web</h2>
  <table class="log">
    <tr><td class="date"><a href="https://wiby.me">wiby.me</a></td>
      <td>A search engine for the old-style web. Hit "surprise me" and lose an hour.</td></tr>
    <tr><td class="date"><a href="https://neocities.org">neocities</a></td>
      <td>GeoCities' spiritual successor. Thousands of hand-built sites.</td></tr>
    <tr><td class="date"><a href="https://512kb.club">512kb.club</a></td>
      <td>A club for sites that respect your bandwidth. This one qualifies with room to spare.</td></tr>
    <tr><td class="date"><a href="http://textfiles.com">textfiles.com</a></td>
      <td>The BBS-era text archive. Where the .nfo tradition lives on.</td></tr>
    <tr><td class="date"><a href="https://16colo.rs">16colo.rs</a></td>
      <td>The ANSI and ASCII art scene archive, 1989 to now.</td></tr>
    <tr><td class="date"><a href="https://nownownow.com">nownownow</a></td>
      <td>The directory of /now pages. Mine is <a href="/now/">here</a>.</td></tr>
  </table>

  <h2>blogroll</h2>
  <p>
    <em>Reserved for the chronicles of fellow wizards. If you keep a build
    log of your own, <a href="https://tally.so/r/XXXXXXX" rel="noopener">sign the book</a> and leave
    the address.</em>
  </p>
</Base>
